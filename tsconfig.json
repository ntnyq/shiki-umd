{
  "extends": "@ntnyq/tsconfig/strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["tests/fixtures"]
}
